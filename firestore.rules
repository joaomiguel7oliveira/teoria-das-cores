rules_version = '2';
// Regras do jogo Teoria das Cores (Mundo SENAI) — cópia do que está publicado no console do Firebase
service cloud.firestore {
  match /databases/{database}/documents {
    // regras do jogo e rodadas: todos leem; só o moderador logado altera
    match /config/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /rodadas/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // partidas: qualquer estação grava uma partida nova (com formato válido); só o moderador edita ou apaga
    match /partidas/{doc} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['rodada', 'rodadaNome', 'nome', 'total', 'maximo', 'fases', 'estacao', 'criadoEm'])
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 20
        && request.resource.data.rodada is string
        && request.resource.data.total is int && request.resource.data.total >= 0
        && request.resource.data.maximo is int && request.resource.data.total <= request.resource.data.maximo
        && request.resource.data.maximo <= 1200;
      allow update, delete: if request.auth != null;
    }
    // recorde do evento: só pode subir (pelo aproveitamento total/maximo, comparado em multiplicação cruzada); o moderador pode corrigir
    match /recorde/{doc} {
      allow read: if true;
      allow create: if request.resource.data.total is int && request.resource.data.maximo is int && request.resource.data.maximo > 0;
      allow update: if request.auth != null || (request.resource.data.total is int && request.resource.data.maximo is int && request.resource.data.maximo > 0
        && request.resource.data.total * resource.data.maximo > resource.data.total * request.resource.data.maximo);
      allow delete: if request.auth != null;
    }
    // estações (cada PC do jogo): todos leem; o PC grava o próprio status (formato válido); só o moderador apaga
    match /estacoes/{id} {
      allow read: if true;
      allow create, update: if id.size() <= 20
        && request.resource.data.keys().hasOnly(['status', 'jogador', 'rodada', 'fila', 'atualizado', 'inicio'])
        && request.resource.data.status in ['livre', 'jogando', 'concluiu', 'demo']
        && request.resource.data.jogador is string && request.resource.data.jogador.size() <= 20
        && request.resource.data.fila is int && request.resource.data.fila <= 1000;
      allow delete: if request.auth != null;
    }
  }
}
